# ========================================================
# FILE MẪU BIẾN MÔI TRƯỜNG - CINEMA TICKET SYSTEM (ĐỀ 11)
# Copy file này thành .env trước khi khởi chạy hệ thống:
# cp .env.example .env (hoặc copy .env.example .env trên Windows)
# ========================================================

# Application Configuration
NODE_ENV=production
PORT=3000
APP_PORT_HOST=3001

# MySQL Database Configuration
# LƯU Ý: Tuyệt đối không dùng tài khoản root cho ứng dụng Backend
DB_HOST=db
DB_PORT=3306
DB_NAME=cinema_booking
DB_USER=cinema_user
DB_PASSWORD=CinemaSecure_ChangeMe_2026!

# MySQL Root (Chỉ dùng cho khởi tạo và bảo trì quản trị)
MYSQL_ROOT_PASSWORD=RootAdminSecure_ChangeMe_2026!

# phpMyAdmin Configuration
PMA_PORT_HOST=8081

# Nginx Reverse Proxy Configuration (Sử dụng 8080 và 8443 tránh xung đột Windows HTTP.sys)
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Monitoring Ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
CADVISOR_PORT=8082
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GrafanaAdmin_ChangeMe_2026!

# Centralized Logging Ports
LOKI_PORT=3100
